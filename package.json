{
  "name": "dsh-ios-diag",
  "version": "0.4.0",
  "description": "iOS 诊断与取证工具包：体检、内存、日志、调用栈、pcap、统一事件表与报告（DSH 插件 + MCP）。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./core": "./core.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "LICENSE",
    "README.md",
    "bin",
    "client.js",
    "configs",
    "cordis.patch.yml",
    "core.js",
    "docs",
    "icon.svg",
    "index.js",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "hub": {
      "summary": "iOS 诊断与取证：装真机前体检、模拟器内存/日志/调用栈、真机录制与类型下钻、pcap 解析、统一事件表与报告；同时提供 stdio MCP server 与代码健康扫描。"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "bin": {
    "dsh-ios-diag-mcp": "./bin/mcp.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build:client": "node scripts/build-client.mjs",
    "handoff": "node scripts/handoff.mjs",
    "report": "node scripts/report-from-run.mjs",
    "health": "node scripts/health-scan.mjs"
  }
}
